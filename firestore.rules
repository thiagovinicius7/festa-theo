rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function ehDono() {
      return request.auth != null
        && request.auth.token.email in ['thiagovinicius7@gmail.com'];
    }

    function qtd(v) {
      return v is int && v >= 0 && v <= 30;
    }

    function confirmacaoValida() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nome', 'vai', 'criancas', 'adolescentes', 'adultos', 'total', 'recado', 'quando'])
        && d.nome is string && d.nome.size() >= 2 && d.nome.size() <= 120
        && d.vai is bool
        && qtd(d.criancas) && qtd(d.adolescentes) && qtd(d.adultos)
        && d.total == d.criancas + d.adolescentes + d.adultos
        && (d.vai == false || d.total >= 1)
        && d.recado is string && d.recado.size() <= 500
        && d.quando == request.time;
    }

    // Festa do Theo – 8 anos
    match /festaTheo8/{id} {
      // Convidados (sem login) podem confirmar ou alterar a própria resposta
      allow create, update: if confirmacaoValida();
      // Só o dono lê e apaga
      allow read, delete: if ehDono();
    }

    // Foto da capa: todos leem, só o dono troca (imagem até ~900 KB)
    match /festaTheo8Config/{id} {
      allow read: if true;
      allow delete: if ehDono();
      allow create, update: if ehDono()
        && request.resource.data.keys().hasOnly(['img', 'quando'])
        && request.resource.data.img is string
        && request.resource.data.img.size() < 900000;
    }
  }
}
